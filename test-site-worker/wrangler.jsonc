{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "campbells-crew-private-test-site",
  "main": "worker.js",
  "compatibility_date": "2026-08-16",
  "routes": [
    { "pattern": "campbellscrew.com/test-site*", "zone_name": "campbellscrew.com" },
    { "pattern": "www.campbellscrew.com/test-site*", "zone_name": "campbellscrew.com" }
  ],
  "assets": {
    "directory": "../test-site",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "ratelimits": [
    {
      "name": "LOGIN_RATE_LIMITER",
      "namespace_id": "2017001",
      "simple": { "limit": 8, "period": 60 }
    }
  ]
}
