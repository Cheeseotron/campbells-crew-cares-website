{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "campbells-crew-portal",
  "main": "worker.js",
  "compatibility_date": "2026-09-13",
  "assets": {
    "directory": "../portal",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {
    "PORTAL_MODE": "closed"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "campbells-crew-portal",
      "database_id": "d3e2d113-1f43-4da2-a19a-79cd9e6f42bc"
    }
  ],
  "r2_buckets": [
    {
      "binding": "PRIVATE_UPLOADS",
      "bucket_name": "campbells-crew-portal-private"
    }
  ]
}
