{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "campbells-crew-portal",
  "main": "worker.js",
  "compatibility_date": "2026-09-13",
  "assets": {
    "directory": "../test-site",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none"
  },
  "vars": {
    "PORTAL_MODE": "closed",
    "GOOGLE_OAUTH_CLIENT_ID": "142554695071-lkl9k20sfcjc0i074opd9h6vhuogip84.apps.googleusercontent.com"
  },
  "routes": [
    { "pattern": "campbellscrew.com/volunteer*", "zone_name": "campbellscrew.com" },
    { "pattern": "campbellscrew.com/apply", "zone_name": "campbellscrew.com" },
    { "pattern": "campbellscrew.com/login", "zone_name": "campbellscrew.com" },
    { "pattern": "campbellscrew.com/forgot-password", "zone_name": "campbellscrew.com" },
    { "pattern": "campbellscrew.com/google-email*", "zone_name": "campbellscrew.com" },
    { "pattern": "campbellscrew.com/setup*", "zone_name": "campbellscrew.com" },
    { "pattern": "campbellscrew.com/logout", "zone_name": "campbellscrew.com" },
    { "pattern": "campbellscrew.com/organizer*", "zone_name": "campbellscrew.com" },
    { "pattern": "campbellscrew.com/portal-api*", "zone_name": "campbellscrew.com" },
    { "pattern": "campbellscrew.com/portal-assets*", "zone_name": "campbellscrew.com" },
    { "pattern": "www.campbellscrew.com/volunteer*", "zone_name": "campbellscrew.com" },
    { "pattern": "www.campbellscrew.com/apply", "zone_name": "campbellscrew.com" },
    { "pattern": "www.campbellscrew.com/login", "zone_name": "campbellscrew.com" },
    { "pattern": "www.campbellscrew.com/forgot-password", "zone_name": "campbellscrew.com" },
    { "pattern": "www.campbellscrew.com/google-email*", "zone_name": "campbellscrew.com" },
    { "pattern": "www.campbellscrew.com/setup*", "zone_name": "campbellscrew.com" },
    { "pattern": "www.campbellscrew.com/logout", "zone_name": "campbellscrew.com" },
    { "pattern": "www.campbellscrew.com/organizer*", "zone_name": "campbellscrew.com" },
    { "pattern": "www.campbellscrew.com/portal-api*", "zone_name": "campbellscrew.com" },
    { "pattern": "www.campbellscrew.com/portal-assets*", "zone_name": "campbellscrew.com" }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "campbells-crew-portal",
      "database_id": "d3e2d113-1f43-4da2-a19a-79cd9e6f42bc"
    }
  ],
  "r2_buckets": [
    {
      "binding": "PRIVATE_UPLOADS",
      "bucket_name": "campbells-crew-portal-private"
    }
  ]
}
