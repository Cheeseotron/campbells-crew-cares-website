{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "campbells-crew-portal",
  "main": "worker.js",
  "compatibility_date": "2026-09-13",
  "assets": {
    "directory": "../portal",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {
    "PORTAL_MODE": "closed"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "campbells-crew-portal",
      "database_id": "REPLACE_AFTER_CREATING_D1"
    }
  ],
  "r2_buckets": [
    {
      "binding": "PRIVATE_UPLOADS",
      "bucket_name": "campbells-crew-portal-private"
    }
  ],
  "ratelimits": [
    {
      "name": "LOGIN_RATE_LIMITER",
      "namespace_id": "REPLACE_AFTER_CREATING_RATE_LIMITER",
      "simple": { "limit": 8, "period": 60 }
    }
  ]
}
